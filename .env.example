# Copie este arquivo para .env.local e preencha com os valores do seu projeto.

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_PRIVADA
MERCADOPAGO_ACCESS_TOKEN=SEU_TOKEN_MERCADOPAGO

# Opcional: usado para validar assinatura (x-signature) dos webhooks do Mercado Pago.
# Deixe vazio para aceitar webhooks sem validação.
MERCADOPAGO_WEBHOOK_SECRET=